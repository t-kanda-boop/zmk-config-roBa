#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&trackball {
    // automouse-layer = <4>;
    // scroll-layers = <5>;
    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };
    };

    behaviors {
        ek: eisu_kana {
            compatible = "zmk,behavior-tap-dance";
            label = "Eisu / Kana";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2>, <&kp LANGUAGE_1>;
    
            tapping-term-ms = <250>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E                    &kp R      &kp T                                 &kp Y      &kp U  &kp I            &kp O     &kp P
&kp A             &kp S         &kp D                    &kp F      &kp G  &mkp MB3        &kp COMMA      &kp H      &kp J  &kp K            &kp L     &kp TAB
&kp Z             &kp X         &kp C                    &kp V      &kp B  &kp ESCAPE      &kp DOT        &kp N      &kp M  &kp RIGHT_SHIFT  &mkp MB1  &mkp MB2
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp LANG_ZENKAKUHANKAKU  &kp SPACE  &mo 1  &mo 2           &kp BACKSPACE  &kp ENTER                                    &kp DELETE
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        number_layer {
            bindings = <
&kp NUMBER_1    &kp NUMBER_2    &kp NUMBER_3    &kp NUMBER_4    &kp NUMBER_5                                    &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9   &kp NUMBER_0
&none           &kp SEMICOLON   &kp SQT         &kp UP_ARROW    &kp EQUAL        &trans      &kp LEFT_BRACKET   &kp MINUS     &kp GRAVE     &kp SLASH     &kp BACKSLASH  &trans
&kp LANGUAGE_2  &kp LANGUAGE_1  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans      &kp RIGHT_BRACKET  &none         &none         &trans        &none          &none
&trans          &trans          &trans          &trans          &none            &none       &trans             &trans                                                   &trans
            >;
        };

        fanc_layer {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                       &kp F6      &kp F7      &kp F8   &kp F9    &kp F10
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &trans      &none   &kp F16     &kp F17     &kp F18  &kp F19   &kp F20
&kp F21  &kp F22  &kp F23  &kp F24  &none    &trans      &none   &bt BT_PRV  &bt BT_NXT  &trans   &mkp MB4  &mkp MB5
&trans   &trans   &trans   &trans   &none    &none       &trans  &trans                                     &trans
            >;
        };
    };
};
